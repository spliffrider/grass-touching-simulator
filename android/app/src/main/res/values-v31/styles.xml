        <item name="android:windowBackground">@color/grass_background</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/grass_background</item>
        <item name="android:statusBarColor">@color/grass_background</item>
        <item name="android:colorAccent">#B7EBA5</item>
        <item name="android:windowSplashScreenBackground">@color/grass_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>
</resources>
