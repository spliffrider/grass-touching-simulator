{
  "name": "grass-touching-simulator",
  "version": "0.1.0",
  "description": "A cozy incremental clicker about touching grass.",
  "private": true,
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "audit:code": "knip --reporter compact",
    "check": "npm run lint && npm run audit:code && npm run test && npm run build",
    "preview": "vite preview --host 127.0.0.1",
    "android:assets": "npm run build && node scripts/prepare-android-assets.mjs",
    "android:apk": "node scripts/build-android.mjs",
    "sync:mac:status": "node scripts/sync-mac-mini.mjs status",
    "sync:mac:handoff": "node scripts/sync-mac-mini.mjs handoff",
    "sync:mac:resume": "node scripts/sync-mac-mini.mjs resume"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "knip": "^6.29.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.10"
  }
}
